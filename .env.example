# IBM Quantum credentials
# Get your token at https://quantum.cloud.ibm.com/
IBM_QUANTUM_TOKEN=your_api_token_here

# Optional: target a specific instance (recommended)
# Found under Instances on the IBM Quantum dashboard
IBM_QUANTUM_INSTANCE=crn:v1:bluemix:public:quantum-computing:us-east:a/...:..::

# Simulator defaults
SIMULATOR_DEVICE=CPU        # CPU or GPU
SIMULATOR_METHOD=automatic  # statevector, density_matrix, etc.

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000

# SQLite database path
DATABASE_URL=sqlite:///./qlab.db
